;; Each async canon built-in, in each of its immediate shapes.
(component
  (type $ST (stream u8))
  (type $FT (future u32))
  (core module $M (memory (export "mem") 1) (table (export "tbl") 1 funcref))
  (core instance $i (instantiate $M))
  (alias core export $i "mem" (core memory $m))
  (alias core export $i "tbl" (core table $t))
  ;; Keeps thread.new-indirect's core type index (1) distinct from its table index (0).
  (core type (func))
  (core type $start (func (param i32)))
  (core func (canon task.return))
  (core func (canon task.return (result u32)))
  (core func (canon task.return (result string) (memory $m) string-encoding=utf16))
  (core func (canon task.cancel))
  (core func (canon subtask.cancel))
  (core func (canon subtask.cancel async))
  (core func (canon subtask.drop))
  (core func (canon context.get i32 0))
  (core func (canon context.set i32 1))
  (core func (canon thread.yield))
  (core func (canon thread.yield cancellable))
  (core func (canon thread.suspend))
  (core func (canon thread.suspend cancellable))
  (core func (canon thread.index))
  (core func (canon thread.new-indirect $start (table $t)))
  (core func (canon stream.new $ST))
  (core func (canon stream.read $ST (memory $m)))
  (core func (canon stream.read $ST async (memory $m)))
  (core func (canon stream.write $ST (memory $m)))
  (core func (canon stream.write $ST async (memory $m)))
  (core func (canon stream.cancel-read $ST))
  (core func (canon stream.cancel-read $ST async))
  (core func (canon stream.cancel-write $ST))
  (core func (canon stream.cancel-write $ST async))
  (core func (canon stream.drop-readable $ST))
  (core func (canon stream.drop-writable $ST))
  (core func (canon future.new $FT))
  (core func (canon future.read $FT (memory $m)))
  (core func (canon future.read $FT async (memory $m)))
  (core func (canon future.write $FT (memory $m)))
  (core func (canon future.write $FT async (memory $m)))
  (core func (canon future.cancel-read $FT))
  (core func (canon future.cancel-read $FT async))
  (core func (canon future.cancel-write $FT))
  (core func (canon future.cancel-write $FT async))
  (core func (canon future.drop-readable $FT))
  (core func (canon future.drop-writable $FT))
  (core func (canon waitable-set.new))
  (core func (canon waitable-set.wait (memory $m)))
  (core func (canon waitable-set.wait cancellable (memory $m)))
  (core func (canon waitable-set.poll (memory $m)))
  (core func (canon waitable-set.poll cancellable (memory $m)))
  (core func (canon waitable-set.drop))
  (core func (canon waitable.join))
  (core func (canon backpressure.inc))
  (core func (canon backpressure.dec)))
