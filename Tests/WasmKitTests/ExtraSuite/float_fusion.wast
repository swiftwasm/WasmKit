  (func (export "check") (param $k i32) (result i32) (local $i i32) (local $n i32) (local $o i32) (local $x f64) (local $y f64)
    (loop $l
      (local.set $o (i32.mul (local.get $i) (i32.const 24)))
      (local.set $x (call_indirect (type $bin) (f64.load (i32.add (local.get $o) (i32.const 0))) (f64.load (i32.add (local.get $o) (i32.const 8))) (f64.load (i32.add (local.get $o) (i32.const 16))) (i32.shl (local.get $k) (i32.const 1))))
      (local.set $y (call_indirect (type $bin) (f64.load (i32.add (local.get $o) (i32.const 0))) (f64.load (i32.add (local.get $o) (i32.const 8))) (f64.load (i32.add (local.get $o) (i32.const 16))) (i32.add (i32.shl (local.get $k) (i32.const 1)) (i32.const 1))))
